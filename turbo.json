{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "db:generate": {},
    "db:push": { "cache": false },
    "build": {
      "dependsOn": ["^build", "^db:generate", "^db:push"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format:check": {}
  }
}
